{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "africafunds/requirement.schema.json",
  "type": "object",
  "required": ["id", "title", "status", "authority", "acceptance_criteria", "evidence_required"],
  "properties": {
    "id": {"type": "string", "pattern": "^AF-REQ-[0-9]{3}$"},
    "title": {"type": "string"},
    "status": {"enum": ["DISCOVERED", "READY", "IN_PROGRESS", "VERIFIED", "DONE", "BLOCKED", "NOT_APPLICABLE"]},
    "authority": {"type": "string"},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evidence_required": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
