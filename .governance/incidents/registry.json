          "d58508f0d3e759b0456c1268b5105068221bfbc4",
          "9f051c035e4bf72f919004f5a654ccf015f159ee"
        ]
      },
      "root_cause": {
        "status": "PROVEN",
        "statement": "Deux défauts de conception du contrôle: absence de pipefail/capture RC, puis absence d'isolation d'erreur du contrôle C5.",
        "evidence_refs": [
          "d58508f0d3e759b0456c1268b5105068221bfbc4",
          "9f051c035e4bf72f919004f5a654ccf015f159ee"
        ],
        "why_not_proven": null
      },
      "contributing_factors": [
        {
          "status": "PROVEN",
          "statement": "Le rapport généré faisait autorité production; un faux vert avait donc un impact de gouvernance élevé."
        }
      ],
      "corrective_actions": [
