{
  "name": "api-opcvm",
  "version": "1.0.0",
  "description": "API backend pour la plateforme d'analyse de fonds OPCVM",
  "main": "services/gateway/index.js",
  "scripts": {
    "start": "node app.js",
    "start:gateway": "node services/gateway/index.js",
    "start:auth": "node services/auth/index.js",
    "start:funds": "node services/funds/index.js",
    "start:performance": "node services/performance/index.js",
    "start:portfolio": "node services/portfolio/index.js",
    "start:analytics": "node services/analytics/index.js",
    "start:reference": "node services/reference/index.js",
    "start:notification": "node services/notification/index.js",
    "start:services": "npm run start:gateway & npm run start:auth & npm run start:funds & npm run start:performance & npm run start:portfolio & npm run start:analytics & npm run start:reference & npm run start:notification",
    "dev": "nodemon app.js",
    "test": "jest --forceExit",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:status": "npx sequelize-cli db:migrate:status",
    "seed": "npx sequelize-cli db:seed:all",
    "db:init": "node scripts/init-db.js",
    "db:init:alter": "node scripts/init-db.js --alter",
    "db:init:force": "node scripts/init-db.js --force"
  },
  "dependencies": {
    "@clickhouse/client": "^1.6.0",
    "@magic-sdk/admin": "^2.0.1",
    "@socktrader/indicators": "^2.0.3",
    "async": "^3.2.5",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "bottleneck": "^2.19.5",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "date-fns": "^2.30.0",
    "docx": "^8.5.0",
    "docxtemplater": "^3.49.1",
    "docxtemplater-image-module-free": "^1.1.1",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "mathjs": "^12.0.0",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.1",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.15",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.1.7",
    "portfolio-allocation": "^0.0.11",
    "portfolio-analytics": "^0.0.4",
    "puppeteer": "^22.13.1",
    "quants": "^0.0.5",
    "sequelize": "^6.32.1",
    "simple-statistics": "^7.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.5"
  },
  "author": "JF",
  "license": "ISC"
}
