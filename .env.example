## ============================
## Server Configuration
## ============================
PORT=3005
NODE_ENV=development

## ============================
## Database Configuration
## ============================
DB_NAME=fund_opcvm
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_DIALECT=mysql
DB_TIMEZONE=+00:00

## ============================
## JWT Authentication
## ============================
JWT_SECRET=your_jwt_secret_here

## ============================
## Email (Nodemailer / Gmail SMTP)
## ============================
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

## ============================
## Frontend URL
## ============================
FRONTEND_URL=http://localhost:3000

## ============================
## Magic SDK
## ============================
MAGIC_SECRET_KEY=your_magic_secret_key

## ============================
## API URLs
## ============================
API_BASE_URL=http://localhost:3005
SITE_BASE_URL=http://localhost:3000

## ============================
## Microservices - Ports
## ============================
GATEWAY_PORT=3005
AUTH_PORT=3010
FUND_PORT=3011
PERFORMANCE_PORT=3012
PORTFOLIO_PORT=3013
ANALYTICS_PORT=3014
REFERENCE_PORT=3015
NOTIFICATION_PORT=3016

## ============================
## Microservices - URLs (used by gateway)
## ============================
AUTH_SERVICE_URL=http://localhost:3010
FUND_SERVICE_URL=http://localhost:3011
PERFORMANCE_SERVICE_URL=http://localhost:3012
PORTFOLIO_SERVICE_URL=http://localhost:3013
ANALYTICS_SERVICE_URL=http://localhost:3014
REFERENCE_SERVICE_URL=http://localhost:3015
NOTIFICATION_SERVICE_URL=http://localhost:3016

## ============================
## CORS - Allowed Origins (comma-separated)
## ============================
ALLOWED_ORIGINS=http://localhost:3000
