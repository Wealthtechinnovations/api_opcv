{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LIV inventory domain contract",
  "type": "object",
  "required": [
    "id",
    "name",
    "source_route",
    "comparison_baseline",
    "coverage",
    "output_ref",
    "checks",
    "required",
    "trigger",
    "read_only",
    "change_action"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^INV-[0-9]{2,}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "source_route": {
      "type": "string",
      "minLength": 1
    },
    "comparison_baseline": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "enum": [
        "VERIFIED",
        "VERIFIED_METADATA",
        "PARTIAL",
        "PENDING",
        "CONFLICT",
        "ERROR",
        "STALE"
      ]
    },
    "output_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "checks": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "type": "boolean"
    },
    "trigger": {
      "type": "string"
    },
    "read_only": {
      "const": true
    },
    "change_action": {
      "type": "string"
    }
  }
}
