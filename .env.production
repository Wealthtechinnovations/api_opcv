## ============================
## Server Configuration
## ============================
PORT=3005
NODE_ENV=production

## ============================
## Database Configuration
## ============================
DB_NAME=fund_opcvm
DB_USER=fund_opcvm
DB_PASSWORD=CHANGER_MOT_DE_PASSE_FORT
DB_HOST=localhost
DB_DIALECT=mysql
DB_TIMEZONE=+00:00
DB_POOL_MAX=20
DB_POOL_MIN=5

## ============================
## JWT Authentication
## ============================
## Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGER_GENERER_NOUVEAU_SECRET

## ============================
## Email (Nodemailer / Gmail SMTP)
## ============================
EMAIL_USER=kouassijauressigl@gmail.com
EMAIL_PASSWORD=CHANGER_APP_PASSWORD_GMAIL

## ============================
## Magic Link Authentication
## ============================
MAGIC_SECRET_KEY=CHANGER_CLE_MAGIC_SECRET

## ============================
## Frontend / Site URL
## ============================
FRONTEND_URL=https://africafunds.chainsolutions.fr
API_BASE_URL=https://africafunds.chainsolutions.fr
SITE_BASE_URL=https://africafunds.chainsolutions.fr

## ============================
## ClickHouse Analytics (optional)
## ============================
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=fund_analytics
CLICKHOUSE_SYNC_INTERVAL_MINUTES=60

## ============================
## Database Sync
## ============================
## Set to 'true' on first deployment to auto-create/update tables
DB_SYNC_ALTER=true

## ============================
## Microservice Ports (if using gateway mode)
## ============================
GATEWAY_PORT=3006
AUTH_PORT=3010
FUND_PORT=3011
PERFORMANCE_PORT=3012
PORTFOLIO_PORT=3013
ANALYTICS_PORT=3014
REFERENCE_PORT=3015
NOTIFICATION_PORT=3016
